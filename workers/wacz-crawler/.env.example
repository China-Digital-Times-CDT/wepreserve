# Copy to .env (gitignored) and fill in. Used by docker-compose.yml (#42).

# --- residential egress (Tailscale exit node) ---
# A reusable/ephemeral auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxical
# The HOME exit node's tailnet IP or MagicDNS name (must be advertising
# --advertise-exit-node and approved in the admin console). NOT mars.
TS_EXIT_NODE=100.x.y.z

# --- the crawl ---
SEED_URL=https://thewitnesshk.com/
# SCOPE=prefix          # prefix | host | domain | page
# LIMIT=300             # max pages
# WORKERS=2             # keep low + polite over a home connection
# PAGE_DELAY=2          # seconds of extra delay per page
# COLLECTION=thewitness-2026-11-11

# --- R2 upload (optional; omit to keep WACZ local in ./crawls) ---
# Browsertrix S3 upload → R2 (S3-compatible). Bucket + trailing slash.
# STORE_ENDPOINT_URL=https://5c97632bbe2152c4cff0230f630d0866.r2.cloudflarestorage.com/shko-public/
# STORE_ACCESS_KEY=      # R2 S3 access key id (32 hex)
# STORE_SECRET_KEY=      # R2 S3 secret (64 hex)
# STORE_PATH=wacz/thewitness/
# STORE_FILENAME=@id-@ts.wacz
