umn":1604,"offset":2693},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"faces-of-the-crackdown"}},{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"films","alias":"🎬 Films & Documentaries","position":{"start":{"line":11,"column":1732,"offset":2821},"end":{"line":11,"column":1766,"offset":2855},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"films"}},{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"press-freedom","alias":"📰 Press Freedom under Siege","position":{"start":{"line":11,"column":1977,"offset":3066},"end":{"line":11,"column":2023,"offset":3112},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"press-freedom"}},{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"sites","alias":"websites or online causes","position":{"start":{"line":20,"column":34,"offset":3655},"end":{"line":20,"column":71,"offset":3692},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"sites"}},{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"participation","alias":"contribute","position":{"start":{"line":20,"column":201,"offset":3822},"end":{"line":20,"column":231,"offset":3852},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"participation"}},{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"sponsorship","alias":"sponsor","position":{"start":{"line":20,"column":254,"offset":3875},"end":{"line":20,"column":279,"offset":3900},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"sponsorship"}},{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"sites.appledaily","alias":"sites.appledaily","position":{"start":{"line":23,"column":3,"offset":3951},"end":{"line":23,"column":23,"offset":3971},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"sites.appledaily"}},{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"sites.inmediahk","alias":"sites.inmediahk","position":{"start":{"line":24,"column":3,"offset":3986},"end":{"line":24,"column":22,"offset":4005},"indent":[]},"xvault":false,"sameFile":false,"to":{"fname":"sites.inmediahk"}}],"anchors":{"goals":{"type":"header","text":"Goals","value":"goals","line":19,"column":0,"depth":2},"quick-facts":{"type":"header","text":"Quick Facts","value":"quick-facts","line":24,"column":0,"depth":2}},"children":["fzfda8r3h330gsr6wg5db9w","74owa8sp34nmlvdwk5io11k","dr6y9n9s72kljfnr7bpwvqj","zlweal1kjlpoam4j62c2tmd1","mcinhplp2561j8cd3ggwbyy5","mox9iceolv8vwqnait2j2ga","gvw1ox7itfk6rrbvvp082bey","9e5b0uhf2vl7gk4rj1tzp3x","iu6nr9qel896bjhbckfl05d","vzihkvznemcaaef2br0s1co","ebwvkii7n5nl76w21b65gm5","wx39zljncctue32jn06u29u","brr1zrug1jl02gi80d1dv8c","aqgv6hy8557vuejq41qf8o49q","82f12j06kndkno9ujbxvau2g"],"parent":null,"data":{},"body":"\n[![Great Extinction](/assets/extinctions.jpeg)](/notes/wx39zljncctue32jn06u29u/) \n> (_Courtesy: [Hong Kong Freepress](https://hongkongfp.com/2021/11/28/explainer-over-50-groups-gone-in-11-months-how-hong-kongs-pro-democracy-forces-crumbled/), 2021_) \n\nSHKO (Save Hong Kong Online) is a community-driven project dedicated to preserving the rapidly disappearing websites and online resources of Hong Kong’s civil society and independent media since 2019. In response to the sweeping shutdowns caused by political changes in Hong Kong, we aim to safeguard digital heritage before it vanishes. This project is anonymous, open source, and supported by a global network of contributors.\n\nWhile most sites in our archive were forced offline due to Hong Kong’s political deterioration, it’s important to note that [[RFA Cantonese|sites.rfa_cantonese]] is the only site here closed not because of Hong Kong’s situation, but due to internal political decisions in the United States.\n\nExplore our full list of preserved sites and archives on the [Collections page](/notes/wx39zljncctue32jn06u29u/).\n\nRecent work: documenting the [[Hong Kong Fire 2025|hong-kong-fire-2025]] tragedy at Wang Fuk Court (168 dead, ongoing probes into flammable mesh/foam, bid-rigging, and a judge-led review), including activism, timeline, and investigation subpages; and the [[⚖️ Jimmy Lai case|faces-of-the-crackdown.jimmy-lai]] — Apple Daily founder sentenced to 20 years under the National Security Law (Feb 2026), with coverage of press freedom impact and international response; and [[🎵 Glory to Hong Kong|glory-to-hong-kong]] — the 2019 protest anthem and the 2024 court order that made it the first song banned in Hong Kong since the 1997 handover; and [[📕 Book Censorship under the NSL|book-censorship]] — how Hong Kong criminalised the printed word, from the banned Sheep Village children's-book trilogy (whose speech-therapist authors were jailed for sedition) and purged public libraries to the 2026 bookshop raids; and [[🗽 Statues & Monuments|statues]] — how Hong Kong's public monuments to Tiananmen and the 2019 protests (the Pillar of Shame, the Goddess of Democracy, Lady Liberty) were removed, seized as police evidence, and driven into exile abroad; and [[⚖️ The Hong Kong 47|hong-kong-47]] — the largest National Security Law case, in which 45 pro-democracy figures were jailed for up to 10 years over a 2020 opposition primary election; and [[🕯️ Tiananmen Vigil|tiananmen-vigil]] — the thirty-year Victoria Park candlelight vigil for the 1989 crackdown, the largest June 4th commemoration on Chinese soil, now banned and its organisers jailed; and [[✊ Faces of the Crackdown|faces-of-the-crackdown]] — a human index to the publishers, students, unionists and clergy jailed, exiled or tried under the National Security Law; and [[🎬 Films & Documentaries|films]] — the protest movement on film, a decade of documentaries and features (Ten Years, Revolution of Our Times, the Joshua Wong doc) now largely banned or unshowable in Hong Kong, gathered with their trailers; and [[📰 Press Freedom under Siege|press-freedom]] — how one of Asia's freest presses was dismantled in five years, from the raids that closed Apple Daily and Stand News to the revived sedition law now reaching lone online reporters.\n\n## Goals\n- To preserve as much information as possible before its disappearance during Hong Kong's great transition\n- To illustrate a viable method that everyone can use to help preserve online heritage with no pains\n- To demonstrate global collaborations to save local digital heritages with best practices\n\n## Quick Facts\n\nWe are working on over dozens of [[websites or online causes | sites]] in Hong Kong in the past two decades which has been forced to shutdown or at the brink of disappearing. We'd welcome anyone help [[contribute | participation]] to the content and/or [[sponsor | sponsorship]] our program to sustain it together. \n\nExamples:\n- [[sites.appledaily]] (Extincted)\n- [[sites.inmediahk]] (In Danger)\n\n\n"},"collectionChildren":null,"customHeadContent":null,"config":{"version":5,"dev":{"enablePreviewV2":true},"commands":{"lookup":{"note":{"selectionMode":"extract","confirmVaultOnCreate":true,"vaultSelectionModeOnCreate":"smart","leaveTrace":false,"bubbleUpCreateNew":true,"fuzzThreshold":0.2}},"randomNote":{},"insertNote":{"initialValue":"templates"},"insertNoteLink":{"aliasMode":"none","enableMultiSelect":false},"insertNoteIndex":{"enableMarker":false},"copyNoteLink":{"aliasMode":"title"},"templateHierarchy":"template"},"workspace":{"vaults":[{"fsPath":"vault"}],"journal":{"dailyDomain":"daily","name":"journal","dateFormat":"y.MM.dd","addBehavior":"childOfDomain"},"scratch":{"name":"scratch","dateFormat":"y.MM.dd.HHmmss","addBehavior":"asOwnDomain"},"task":{"name":"","dateFormat":"","addBehavior":"childOfCurrent","statusSymbols":{"":" ","wip":"w","done":"x","assigned":"a","moved":"m","blocked":"b","delegated":"l","dropped":"d","pending":"y"},"prioritySymbols":{"H":"high","M":"medium","L":"low"},"todoIntegration":false,"createTaskSelectionType":"selection2link","taskCompleteStatus":["done","x"]},"graph":{"zoomSpeed":1,"createStub":false},"enableAutoCreateOnDefinition":false,"enableXVaultWikiLink":false,"enableRemoteVaultInit":true,"enableUserTags":true,"enableHashTags":true,"workspaceVaultSyncMode":"noCommit","enableAutoFoldFrontmatter":false,"enableEditorDecorations":true,"maxPreviewsCached":10,"maxNoteLength":204800,"enableFullHierarchyNoteTitle":false},"preview":{"enableFMTitle":true,"enableNoteTitleForLink":true,"enableFrontmatterTags":true,"enableHashesForFMTags":false,"enableMermaid":true,"enablePrettyRefs":true,"enableKatex":true,"automaticallyShowPreview":false},"publishing":{"siteUrl":"https://savehkonline.org","enableFMTitle":true,"enableNoteTitleForLink":true,"enableMermaid":true,"logoPath":"vault/assets/yellow_black_logo.png","enableKatex":true,"copyAssets":true,"siteHierarchies":["root"],"writeStubs":false,"siteRootDir":"docs","seo":{"title":"Save Hong Kong Online","description":"Using community driven backup services to backup Hong Kong's extincting web heritages"},"github":{"enableEditLink":true,"editLinkText":"Edit this page on GitHub","editBranch":"main","editViewMode":"tree","editRepository":"https://github.com/China-Digital-Times-CDT/wepreserve"},"enableSiteLastModified":true,"enableFrontmatterTags":true,"enableHashesForFMTags":false,"enableRandomlyColoredTags":true,"enablePrettyLinks":true,"duplicateNoteBehavior":{"action":"useVault","payload":["vault"]},"enablePrettyRefs":true,"siteFaviconPath":"favicon.ico","siteIndex":"root","enableTaskNotes":true,"searchMode":"lookup"}}},"__N_SSG":true}