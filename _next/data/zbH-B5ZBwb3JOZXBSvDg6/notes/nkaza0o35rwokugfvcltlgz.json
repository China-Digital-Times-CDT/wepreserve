"tiananmen-vigil","vaultName":"vault"},"type":"backlink","position":{"start":{"line":106,"column":98,"offset":14601},"end":{"line":106,"column":130,"offset":14633},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"extra.8964","vaultName":"vault"},"type":"backlink","position":{"start":{"line":5,"column":32,"offset":682},"end":{"line":5,"column":64,"offset":714},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"extra.8964","vaultName":"vault"},"type":"backlink","position":{"start":{"line":9,"column":5,"offset":797},"end":{"line":9,"column":37,"offset":829},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"faces-of-the-crackdown.chow-hang-tung","vaultName":"vault"},"type":"backlink","position":{"start":{"line":2,"column":104,"offset":104},"end":{"line":2,"column":136,"offset":136},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"faces-of-the-crackdown.chow-hang-tung","vaultName":"vault"},"type":"backlink","position":{"start":{"line":7,"column":111,"offset":720},"end":{"line":7,"column":143,"offset":752},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"faces-of-the-crackdown.chow-hang-tung","vaultName":"vault"},"type":"backlink","position":{"start":{"line":24,"column":685,"offset":3547},"end":{"line":24,"column":717,"offset":3579},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"faces-of-the-crackdown.chow-hang-tung","vaultName":"vault"},"type":"backlink","position":{"start":{"line":32,"column":713,"offset":5159},"end":{"line":32,"column":745,"offset":5191},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"faces-of-the-crackdown.jimmy-lai","vaultName":"vault"},"type":"backlink","position":{"start":{"line":2,"column":121,"offset":121},"end":{"line":2,"column":153,"offset":153},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"},{"from":{"fname":"faces-of-the-crackdown.joshua-wong","vaultName":"vault"},"type":"backlink","position":{"start":{"line":2,"column":98,"offset":98},"end":{"line":2,"column":130,"offset":130},"indent":[]},"value":"sites.hka","alias":"Hong Kong Alliance"}],"anchors":{"update--subversion-conviction-2026":{"type":"header","text":"Update — subversion conviction (2026)","value":"update--subversion-conviction-2026","line":18,"column":0,"depth":2}},"children":[],"parent":"wx39zljncctue32jn06u29u","data":{}},"body":"<h1 id=\"hka支聯會\"><a aria-hidden=\"true\" class=\"anchor-heading\" href=\"#hka支聯會\"><svg aria-hidden=\"true\" viewBox=\"0 0 16 16\"><use xlink:href=\"#svg-link\"></use></svg></a>HKA|支聯會</h1>\n<p>香港市民支援愛國民主運動聯合會，簡稱支聯會或港支聯， 是香港曾經一個泛民主派政治組織，於1989年5月21日在香港支持八九民運的全球華人大遊行中成立，設有包括「釋放民運人士、平反八九民運」等在內的五大綱領，首屆主席由司徒華擔任。1990年至2019年，支聯會曾連續30年無間斷舉辦六四遊行、維園燭光集會。高峰期時，泛民主派有約一半的立法會議員同時身兼支聯會成員身份。2021年9月25日，特別會員大會通過解散決議。(URL: <a href=\"http://www.alliance.org.hk/\">http://www.alliance.org.hk/</a>, redictect to <a href=\"https://hka8964.wordpress.com/\">https://hka8964.wordpress.com/</a>) (FB Page: <a href=\"https://www.facebook.com/hkalliance\">https://www.facebook.com/hkalliance</a>)</p>\n<p>The Hong Kong Alliance in Support of Patriotic Democratic Movements of China was a pro-democracy organisation that was established on 21 May 1989 in the then British colony of Hong Kong during the 1989 Tiananmen Square protests and massacre in Beijing. After the 4 June massacre, the organisation main goals were the rehabilitation of the democracy movement and the accountability for the massacre. The main activities the organisation held were the annual memorials and commemorations, of which the <a href=\"/notes/82f12j06kndkno9ujbxvau2g\">candlelight vigil in Victoria Park</a> was the most attended, reported and discussed event each year. Due to its stance, the Central government in Beijing considers the organisation subversive. Three leaders, including its vice chairwoman Chow Hang-tung were arrested on other national security charges on 9 September 2021, and its assets were frozen. The Alliance finally decided to dissolve on 25 September after all standing committee members were remanded in custody or jailed. (URL: <a href=\"http://www.alliance.org.hk/\">http://www.alliance.org.hk/</a>, redirected to <a href=\"https://hka8964.wordpress.com/\">https://hka8964.wordpress.com/</a>) (FB Page: <a href=\"https://www.facebook.com/hkalliance\">https://www.facebook.com/hkalliance</a>)</p>\n<p>A screenshot of <a href=\"https://hka8964.wordpress.com/\">https://hka8964.wordpress.com/</a> as of 1 August 2021:\n<img src=\"https://user-images.githubusercontent.com/103475460/165095516-7383e19b-ad93-4294-b92d-1ea710af0d5d.png\" alt=\"image\"></p>\n<p>A screenshot of the Facebook Page of the organisation as of 25 April 2022:\n<img src=\"https://user-images.githubusercontent.com/103475460/165095067-07cd8b2f-ccef-4273-92e2-fd279b349031.png\" alt=\"image\"></p>\n<h2 id=\"update--subversion-conviction-2026\"><a aria-hidden=\"true\" class=\"anchor-heading\" href=\"#update--subversion-conviction-2026\"><svg aria-hidden=\"true\" viewBox=\"0 0 16 16\"><use xlink:href=\"#svg-link\"></use></svg></a>Update — subversion conviction (2026)</h2>\n<p>On <strong>21 August 2026</strong>, more than four years after its dissolution, the Alliance and two of its leaders were convicted of <strong>incitement to subversion</strong> under the National Security Law. Three national-security judges at the <strong>West Kowloon Law Courts</strong> found that chair <strong>Lee Cheuk-yan</strong> (李卓人), barrister vice-chair <strong><a href=\"/notes/boy6xjxp7l4wjtdginmrkjuc\">Chow Hang-tung</a></strong> (鄒幸彤) and the Alliance as an organisation had spread the call to \"<strong>end one-party dictatorship</strong>\" (結束一黨專政) and likened the 2019 protests to the 1989 Tiananmen crackdown to stir hostility toward the Communist Party. Founding member and former lawmaker <strong>Albert Ho</strong> (何俊仁) had pleaded guilty when the trial opened in January. Lee and Chow had been behind bars since <strong>September 2021</strong>; at her <strong>28 August</strong> mitigation hearing Chow declined to plead for leniency, saying the conviction showed that \"<strong>pursuing democracy is a crime</strong>.\"</p>\n<p>On <strong>11 September 2026</strong> the court delivered the sentences: <strong>Chow Hang-tung — 7 years 3 months</strong>, <strong>Lee Cheuk-yan — 7 years</strong>, and <strong>Albert Ho — 5 years 2 months</strong> (reduced for his guilty plea); the dissolved Alliance itself was fined <strong>HK$1.5 million</strong>. Treating the case as \"<strong>of a serious nature</strong>\" — the higher of the sentencing bands under the NSL — the judges pointed to the defendants' \"<strong>mobilising power and influence</strong>\" and to premeditated conduct they \"recalcitrantly pursued,\" even while acknowledging the campaign involved \"<strong>no violence or the threat of violence</strong>\" and no \"specific means of implementation or timetable.\" With roughly five years already served on remand, Lee and Chow have about two years left to serve. The ruling drew condemnation from the UN and overseas rights groups and approval from the Hong Kong government, which hit back at \"external forces.\" France and Germany said they \"deeply regret\" the verdict and urged the pair's release (<a href=\"https://hongkongfp.com/2026/08/21/breaking-hong-kong-tiananmen-vigil-activists-convicted-under-nat-security-law-face-up-to-10-years-prison/\">HKFP: conviction</a> · <a href=\"https://hongkongfp.com/2026/09/11/hong-kong-tiananmen-vigil-activists-sentenced-up-to-7-years-3-months-for-inciting-subversion/\">HKFP: sentencing</a> · <a href=\"https://www.cnn.com/2026/09/10/china/hong-kong-tiananmen-organizers-prison-hnk-intl\">CNN</a> · <a href=\"https://www.aljazeera.com/news/2026/9/11/hong-kong-court-hands-stiff-jail-sentences-to-tiananmen-vigil-activists\">Al Jazeera</a> · <a href=\"https://www.hrw.org/news/2026/08/21/hong-kong-activists-convicted-for-tiananmen-vigils\">Human Rights Watch</a> · <a href=\"https://hongkongfp.com/2026/08/28/national-security-conviction-shows-pursuing-democracy-is-a-crime-tiananmen-vigil-activist-says-in-mitigation-hearing/\">HKFP: mitigation</a>). 香港中文報道：<a href=\"https://thewitnesshk.com/%E6%94%AF%E8%81%AF%E6%9C%83%E8%A2%AB%E6%8C%87%E7%85%BD%E5%8B%95%E9%A1%9B%E8%A6%86%E6%A1%88-%E6%B3%95%E5%BA%AD%E7%B7%9A%E5%A0%B1%E9%81%93%E4%B8%80%E8%A6%BD/\">法庭線《支聯會案報道一覽》</a>（法庭線本身亦為本檔案保存的對象：<a href=\"/notes/c99dpjphzfbdx0bpmy8yalv\">法庭線</a>）· <a href=\"https://theinitium.com/20260911-hongkong-64-hkaspdmc-trial-sentence/\">端傳媒《判刑理由速讀》</a>。 On <strong>17 September 2026</strong> the <strong>European Parliament</strong> escalated the response, adopting a resolution by <strong>459 votes to 12</strong> (86 abstentions) that urged the EU to impose <strong>targeted sanctions</strong> on the Hong Kong officials responsible, under its Global Human Rights Sanctions Regime, and demanded the release of <strong>all</strong> the city's political prisoners — naming Chow, Lee and Ho alongside <a href=\"/notes/jl8k2mxp4vy7nrt1qw5b3ez\">Jimmy Lai</a>, <em>Stand News</em> editor <strong>Chung Pui-kuen</strong> and jailed <a href=\"/notes/74owa8sp34nmlvdwk5io11k\">bookseller Leticia Wong</a>; it also asked the European Commission to examine Hong Kong's separate standing in the <strong>WTO</strong>. The advocacy group <a href=\"/notes/b3gelsp88whuvuotw9f03xs\">Hong Kong Watch</a> — whose policy director <strong>Megan Khoo</strong> said \"the international community will not look away as Hong Kong's national security laws continue to be used to silence journalists, booksellers, and pro-democracy activists\" — welcomed the vote (<a href=\"https://www.hongkongwatch.org/all-posts/2026/17/9/european-parliament-calls-for-sanctions-on-hong-kong-officials-over-arbitrary-detentions-and-crackdown-on-fundamental-freedoms\">Hong Kong Watch</a> · <a href=\"https://www.courthousenews.com/eu-parliament-urges-sanctions-over-hong-kong-jailing-of-activists/\">Courthouse News</a>). The Alliance's <a href=\"/notes/9p6m8bb6dis5fr37njzdlji\">8964 Museum</a> continues to operate from overseas, and its <strong>Pillar of Shame</strong> — seized by police as evidence in this very case — is one of the <a href=\"/notes/aqgv6hy8557vuejq41qf8o49q\">Statues &#x26; Monuments</a> erased from the city's public space. The prosecution was part of the same national-security sweep that produced the <a href=\"/notes/gvw1ox7itfk6rrbvvp082bey\">Hong Kong 47</a> subversion case and the jailing of <a href=\"/notes/jl8k2mxp4vy7nrt1qw5b3ez\">Jimmy Lai</a>.</p>\n<hr>\n<strong>Backlinks</strong>\n<ul>\n<li><a href=\"/notes/zlweal1kjlpoam4j62c2tmd1\">✊ Faces of the Crackdown|鎮壓面孔</a></li>\n<li><a href=\"/notes/gvw1ox7itfk6rrbvvp082bey\">⚖️ The Hong Kong 47|民主派初選案</a></li>\n<li><a href=\"/notes/wx39zljncctue32jn06u29u\">Collections</a></li>\n<li><a href=\"/notes/aqgv6hy8557vuejq41qf8o49q\">🗽 Statues &#x26; Monuments|紀念雕塑</a></li>\n<li><a href=\"/notes/82f12j06kndkno9ujbxvau2g\">🕯️ Tiananmen Vigil|維園六四燭光集會</a></li>\n<li><a href=\"/notes/9p6m8bb6dis5fr37njzdlji\">8964museum | 六四記憶</a></li>\n<li><a href=\"/notes/boy6xjxp7l4wjtdginmrkjuc\">⚖️ Chow Hang-tung|鄒幸彤</a></li>\n<li><a href=\"/notes/jl8k2mxp4vy7nrt1qw5b3ez\">⚖️ Jimmy Lai|黎智英</a></li>\n<li><a href=\"/notes/k96jbfw1qtqp2c3ip7njw988\">⚖️ Joshua Wong|黃之鋒</a></li>\n</ul>","noteIndex":{"id":"pfy4h1nwep9age7eg0u8xe1","title":"SHKO(Save Hong Kong Online)","desc":"","updated":1789214400000,"created":1648525691085,"custom":{"nav_order":0,"permalink":"/"},"fname":"root","type":"note","vault":{"fsPath":"vault"},"contentHash":"b192a0dac8db1eb57473bf74a77169bb","links":[{"type":"wiki","from":{"fname":"root","id":"pfy4h1nwep9age7eg0u8xe1","vaultName":"vault"},"value":"sites.rfa_cantonese","alias":"RFA Cantonese","position":{"start":{"line":7,"column":125,"offset":807},"end":{"line":7,"column":162,"offset":844},"indent":[]},"xvault":false,"sameFile"